# autotradesun backend 환경변수 예시 — 실제 값/secret 은 절대 커밋 금지.
# 이 파일을 backend/.env 로 복사한 뒤 채운다 (.env 는 .gitignore 로 차단됨).

APP_ENV=local
DEFAULT_MODE=SIMULATION

# === 안전 플래그 (기본값 유지 권장 — 본 빌드는 모의/Paper 범위) ===
ENABLE_FUTURES_LIVE_TRADING=false
ENABLE_AI_EXECUTION=false

# === 시세 provider ===
MARKET_DATA_PROVIDER=mock

# === 선물 리스크 정책 ===
FUTURES_MAX_CONTRACTS=1
FUTURES_MAX_MARGIN_USED=1000000
FUTURES_MAX_DAILY_LOSS=200000
FUTURES_MAX_LEVERAGE=10.0

# === 자동 루프 ===
FUTURES_AUTO_TICK_INTERVAL_SECONDS=5

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# KIS 선물 실시세 (placeholder — 본 빌드 미사용, 실제 값 입력 금지)
# KIS_APP_KEY=<YOUR_KIS_APP_KEY>
# KIS_APP_SECRET=<YOUR_KIS_APP_SECRET>
